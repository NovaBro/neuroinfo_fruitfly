      SEED_THRESH: 0.9
    INSTANCE_CREATION_PROCESS: watershed
    OMNIPOSE:
      FLOW_THRESHOLD: 0.4
      MASK_THRESHOLD: 0.0
      NITER: 0
    SEPARATED_DECODERS_DIVIDE_FEATURE_MAPS: False
    SEPARATED_DECODERS_PER_HEAD: False
    STARDIST:
      GRID: []
      NMS_IOU_THRESH: 0.3
      PROB_THRESH: 0.4
    SYNAPSES:
      BLOB_LOG_MAX_SIGMA: 10
      BLOB_LOG_MIN_SIGMA: 5
      BLOB_LOG_NUM_SIGMA: 2
      EXCLUDE_BORDER: False
      MIN_TH_TO_BE_PEAK: 0.2
      PEAK_LOCAL_MAX_MIN_DISTANCE: 1
      POINT_CREATION_FUNCTION: peak_local_max
      REMOVE_CLOSE_POINTS_RADIUS_BY_MASK: False
      REMOVE_CLOSE_POST_POINTS_RADIUS: 0
      REMOVE_CLOSE_PRE_POINTS_RADIUS: 0
      TH_TYPE: auto
    TYPE: regular
