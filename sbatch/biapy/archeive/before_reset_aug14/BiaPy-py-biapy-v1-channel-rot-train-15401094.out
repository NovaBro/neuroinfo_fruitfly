  NUM_CPUS: 12
  NUM_GPUS: 1
  NUM_WORKERS: 12
  PIN_MEM: True
  SEED: 0
TEST:
  ANALIZE_2D_IMGS_AS_3D_STACK: False
  AUGMENTATION: False
  AUGMENTATION_GROUP: auto
  AUGMENTATION_MODE: mean
  BY_CHUNKS:
    ENABLE: False
    FLUSH_EACH: 100
    PHASES: ['prediction', 'instance_creation', 'instance_merging']
    SAVE_OUT_TIF: False
    WORKFLOW_PROCESS:
      ENABLE: True
      INSTANCE_SEG_HALO: -1
      INSTANCE_SEG_MERGE_IOU_TH: 0.3
      TYPE: chunk_by_chunk
    Z_END: -1
    Z_START: -1
  DET_BLOB_LOG_MAX_SIGMA: 10
  DET_BLOB_LOG_MIN_SIGMA: 5
  DET_BLOB_LOG_NUM_SIGMA: 2
  DET_EXCLUDE_BORDER: False
  DET_IGNORE_POINTS_OUTSIDE_BOX: []
  DET_MIN_TH_TO_BE_PEAK: 0.2
  DET_PEAK_LOCAL_MAX_MIN_DISTANCE: 1
  DET_POINT_CREATION_FUNCTION: peak_local_max
  DET_TH_TYPE: manual
  DET_TOLERANCE: 10
  ENABLE: True
  FULL_IMG: False
  MATCHING_STATS: True
  MATCHING_STATS_BY_IMAGE: True
  MATCHING_STATS_THS: [0.3, 0.5, 0.75]
  MATCHING_STATS_THS_COLORED_IMG: []
  METRICS: ['iou']
  METRICS_IN_CPU: False
  POST_PROCESSING:
    APPLY_MASK: False
    DET_WATERSHED: False
    DET_WATERSHED_DONUTS_CLASSES: [-1]
    DET_WATERSHED_DONUTS_NUCLEUS_DIAMETER: 30
    DET_WATERSHED_DONUTS_PATCH: [13, 120, 120]
    DET_WATERSHED_FIRST_DILATION: [-1, -1]
    INSTANCE_REFINEMENT:
      ENABLE: True
      OPERATIONS: ['remove_small_objects']
      VALUES: [500]
    MEASURE_PROPERTIES:
      ENABLE: False
      EXTRA_PROPS: []
      REMOVE_BY_PROPERTIES:
        ENABLE: False
        PROPS: []
        SIGNS: []
        VALUES: []
    MEDIAN_FILTER: False
    MEDIAN_FILTER_AXIS: []
    MEDIAN_FILTER_SIZE: []
    REMOVE_CLOSE_POINTS: False
    REMOVE_CLOSE_POINTS_RADIUS: 0
    REPARE_LARGE_BLOBS_SIZE: -1
    VORONOI_ON_MASK: False
    VORONOI_TH: 0.0
  REDUCE_MEMORY: False
  REUSE_PREDICTIONS: False
  SAVE_MODEL_RAW_OUTPUT: True
  VERBOSE: True
TRAIN:
  BATCH_SIZE: 105
  CHECKPOINT_MONITOR: val_loss
  ENABLE: True
  EPOCHS: 30
  GRADIENT_CLIP_NORM: 0.0
  LR: [0.003]
  LR_SCHEDULER:
    MIN_LR: [-1.0]
    NAME: onecycle
    REDUCEONPLATEAU_FACTOR: 0.5
    REDUCEONPLATEAU_PATIENCE: -1
    WARMUP_COSINE_DECAY_EPOCHS: -1
  METRICS: ['iou']
  OPTIMIZER: ['ADAMW']
  OPT_BETAS: [[0.9, 0.999]]
  PATIENCE: 10
  VERBOSE: False
  W_DECAY: 0.02
